{
  "name": "qwizzle",
  "version": "0.1.0",
  "private": true,
  "description": "Qwizzle monorepo",
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "corepack pnpm --filter qwizzle-web dev",
    "build": "corepack pnpm --filter qwizzle-web build",
    "preview": "corepack pnpm --filter qwizzle-web preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "corepack pnpm --filter qwizzle-web lint",
    "size": "corepack pnpm --filter qwizzle-web build && ls -lh apps/web/dist/assets/*.js | awk '{print $5, $9}'"
  },
  "devDependencies": {
    "@types/node": "^20.11.5",
    "@vitest/coverage-v8": "^1.2.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "keywords": [
    "wordle",
    "word-game",
    "puzzle",
    "react"
  ],
  "author": "Adil Leghari",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  }
}
